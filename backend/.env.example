# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Only needed if the backend ever needs to act as an anon client (rare); frontend uses its own.
SUPABASE_ANON_KEY=replace-me

# LLM providers — server-side only, never exposed to the frontend
GROQ_API_KEY=replace-me
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-1.5-flash

# CORS — comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173

# Environment name, used for logging / feature flags
APP_ENV=development
